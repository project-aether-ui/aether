--!strict
--[[
	verify_core_has_no_framework -- Layer 1 depends on no reactive library and
	names no engine type.

	WHY
	`@zag-js/dialog` depends on the machine core, types, utils, anatomy and a DOM
	query helper. It does not depend on React, Solid or Vue, and it does not
	peer-depend on them either -- checked against the npm registry 2026-09-08.
	`@ark-ui/react` is the layer that knows a framework exists, and it declares
	react a PEER dependency so the application owns the copy.

	Aether already has the upper half: vide is a peer dependency as of milestone
	6. This gate is the lower half, and the architecture already names it --
	`src/controllers/ScrollController.luau` says "Layer 1 in the Aether universal
	architecture: Zero engine dependency, zero reactive framework dependency."
	Nothing enforced that, and nothing counted its neighbours.

	MEMBERSHIP IS BY LOCATION. A file placed under the boundary is under the rule.
	The alternative -- a list inside this gate -- rots the first time someone adds
	a module and does not read the gate.

	THE COUNT IS THE OTHER HALF. Enforcing over a small boundary is easy to pass
	and says little, so this also reports how many modules ANYWHERE under `src/`
	would qualify, and names the ones that already do. That number is what
	milestone 7 moves, and it is generated by asking the source rather than
	written down.
]]

local fs = require("@lune/fs")
local process = require("@lune/process")

local stripComments = require("./source_scan").stripComments

--- Under the rule today. Step B widens this; the gate does not have to change.
local BOUNDARY = { "src/core/", "src/controllers/" }

local SUBJECT = "src/"

--- Roblox types a Layer 1 module has no business naming. `UDim2` and `Vector2`
--- are geometry the host supplies; `Instance` and `GuiObject` are the engine's
--- object model.
local ENGINE_TYPES = { "Instance", "GuiObject", "UDim2", "UDim", "Vector2", "Color3", "Enum" }

local function isVendored(path: string): boolean
	return string.find(path, "roblox_packages", 1, true) ~= nil
		or string.find(path, ".pesde", 1, true) ~= nil
end

local function inBoundary(path: string): boolean
	for _, prefix in ipairs(BOUNDARY) do
		if string.sub(path, 1, #prefix) == prefix then
			return true
		end
	end
	return false
end

--- Strings go before identifiers are counted, and requires are read before that.
--- `className == "GuiObject"` compares against data; `local x: GuiObject` names
--- the engine. Only the second is coupling.
local function stripStrings(src: string): string
	local out = string.gsub(src, "%[%[.-%]%]", '""')
	out = string.gsub(out, '"[^"\n]*"', '""')
	out = string.gsub(out, "'[^'\n]*'", "''")
	return out
end

local function reachesTheFramework(withStrings: string): string?
	if string.find(withStrings, 'require%("[%./]*Deps"%)') then
		return "requires Deps"
	end
	if string.find(withStrings, "@vide") or string.find(withStrings, "roblox_packages/vide") then
		return "requires vide"
	end
	return nil
end

local function namesAnEngineType(codeOnly: string): string?
	for _, ty in ipairs(ENGINE_TYPES) do
		if string.find(codeOnly, `%f[%w_]{ty}%f[^%w_]`) then
			return `names \`{ty}\``
		end
	end
	return nil
end

local result = process.exec("git", { "ls-files", "*.luau" })
if not result.ok then
	error("cannot list tracked files -- is this a git repository?", 0)
end

local failures: { string } = {}
local qualify: { string } = {}
local scanned = 0

for path in string.gmatch(result.stdout, "[^\r\n]+") do
	if not fs.isFile(path) or isVendored(path) then
		continue
	end
	if string.sub(path, 1, #SUBJECT) ~= SUBJECT then
		continue
	end

	scanned += 1
	local withStrings = stripComments(fs.readFile(path))
	local codeOnly = stripStrings(withStrings)

	local why = reachesTheFramework(withStrings) or namesAnEngineType(codeOnly)

	if inBoundary(path) and why then
		table.insert(failures, `{path}: {why}, and it sits under the Layer 1 boundary`)
	end
	if not why then
		table.insert(qualify, path)
	end
end

table.sort(qualify)

print("")
print(`LAYER 1: {#qualify} of {scanned} modules under {SUBJECT} reach no framework and name no engine type`)
for _, path in ipairs(qualify) do
	local mark = if inBoundary(path) then "in " else "out"
	print(`  [{mark}] {path}`)
end

if #failures > 0 then
	print("")
	for _, f in ipairs(failures) do
		print(`  {f}`)
	end
	print(`VERIFY CORE HAS NO FRAMEWORK: FAILED ({#failures} problem(s))`)
	process.exit(1)
else
	print("")
	print(`VERIFY CORE HAS NO FRAMEWORK: PASS (boundary is clean; {#qualify} module(s) qualify, marked in/out above)`)
end
