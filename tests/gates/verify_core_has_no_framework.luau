--!strict
--[[
	verify_core_has_no_framework -- TWO RULES over the same boundary.

	  1. A Layer 1 module reaches no framework: no reactive library, no engine
	     type, no require leaving the boundary.
	  2. A Layer 1 module decides nothing about APPEARANCE. A machine answers
	     what state a thing is in; a colour, a font and the properties carrying
	     them are the caller's to choose, and a primitive takes its styling
	     rather than picking it.

	They are checked separately and they fail separately, because "names
	`Color3`" and "chose a fill" are two different things to fix.

	RULE 2 IS STATED RATHER THAN IMPLIED, and that is the whole reason it is
	here. Every module in this tree names `UDim2` and `Color3` directly -- they
	are the language of a conforming host, available to any file that wants them
	-- so nothing about how a value is reached keeps a machine from choosing one.
	A rule that holds because of the way something is plumbed is a rule that
	stops holding the day the plumbing is simplified, with every gate still
	green.

	WHY
	`@zag-js/dialog` depends on the machine core, types, utils, anatomy and a DOM
	query helper. It does not depend on React, Solid or Vue, and it does not
	peer-depend on them either -- checked against the npm registry 2026-09-08.
	`@ark-ui/react` is the layer that knows a framework exists, and it declares
	react a PEER dependency so the application owns the copy.

	Aether already has the upper half: vide is a peer dependency as of milestone
	6. This gate is the lower half, and the architecture already names it --
	`src/controllers/ScrollController.luau` says "Layer 1 in the Aether universal
	architecture: Zero engine dependency, zero reactive framework dependency."
	Nothing enforced that, and nothing counted its neighbours.

	MEMBERSHIP IS BY LOCATION. A file placed under the boundary is under the rule.
	The alternative -- a list inside this gate -- rots the first time someone adds
	a module and does not read the gate.

	THE COUNT IS THE OTHER HALF. Enforcing over a small boundary is easy to pass
	and says little, so this also reports how many modules ANYWHERE under `src/`
	would qualify, and names the ones that already do. That number is what
	milestone 7 moves, and it is generated by asking the source rather than
	written down.
]]

local fs = require("@lune/fs")
local process = require("@lune/process")

local stripComments = require("./source_scan").stripComments

--- Under the rule today. Step B widens this; the gate does not have to change.
local BOUNDARY = { "src/core/", "src/controllers/" }

local SUBJECT = "src/"

--- Roblox types a Layer 1 module has no business naming. `UDim2` and `Vector2`
--- are geometry the host supplies; `Instance` and `GuiObject` are the engine's
--- object model.
local ENGINE_TYPES = { "Instance", "GuiObject", "UDim2", "UDim", "Vector2", "Color3", "Enum" }

--- What deciding an appearance is spelled as: the constructors of a colour and
--- of a font.
---
--- GEOMETRY IS NOT ON THIS LIST, deliberately. A machine may say a menu is 200
--- wide and where its rows sit -- that is behaviour, and `UDim2` is refused by
--- rule 1 for a different reason entirely. What it may not say is how any of it
--- is painted.
local APPEARANCE_VALUES = { "Color3", "ColorSequence", "ColorSequenceKeypoint", "BrickColor", "Font", "FontFace" }

local function isVendored(path: string): boolean
	return string.find(path, "roblox_packages", 1, true) ~= nil
		or string.find(path, ".pesde", 1, true) ~= nil
end

local function inBoundary(path: string): boolean
	for _, prefix in ipairs(BOUNDARY) do
		if string.sub(path, 1, #prefix) == prefix then
			return true
		end
	end
	return false
end

--- Strings go before identifiers are counted, and requires are read before that.
--- `className == "GuiObject"` compares against data; `local x: GuiObject` names
--- the engine. Only the second is coupling.
local function stripStrings(src: string): string
	local out = string.gsub(src, "%[%[.-%]%]", '""')
	out = string.gsub(out, '"[^"\n]*"', '""')
	out = string.gsub(out, "'[^'\n]*'", "''")
	return out
end

local function reachesTheFramework(withStrings: string): string?
	if string.find(withStrings, 'require%("[%./]*Deps"%)') then
		return "requires Deps"
	end
	if string.find(withStrings, "@vide") or string.find(withStrings, "roblox_packages/vide") then
		return "requires vide"
	end
	return nil
end

--- A THIRD RULE, AND THE ONE THAT MAKES THE OTHER TWO HOLD.
---
--- The first two ask what a module requires DIRECTLY. A core module that
--- required a non-core sibling would pass both while reaching vide through it,
--- because the coupling would be one hop away. The boundary has no outward edges
--- today -- every module under it requires nothing at all -- and this is what
--- keeps that true rather than lucky.
---
--- It is also the difference between a directory and a package. A package cannot
--- reach its consumer because the resolver will not let it; a directory can, and
--- this rule is the resolver we do not have.
local function reachesOutsideTheBoundary(withStrings: string, path: string): string?
	for target in string.gmatch(withStrings, 'require%("([^"]+)"%)') do
		--- An alias or a package is not a sibling module and is not ours to judge
		--- here; rules one and two already refuse the framework by name.
		if string.sub(target, 1, 1) ~= "." then
			continue
		end
		--- `./x` and `../x` from a module already inside the boundary: the only
		--- shape that stays inside is a sibling, which is `./`.
		if string.sub(target, 1, 3) == "../" then
			return `requires \`{target}\`, which leaves the boundary`
		end
	end
	return nil
end

local function namesAnEngineType(codeOnly: string): string?
	for _, ty in ipairs(ENGINE_TYPES) do
		if string.find(codeOnly, `%f[%w_]{ty}%f[^%w_]`) then
			return `names \`{ty}\``
		end
	end
	return nil
end

--- RULE 2. A colour, a font, or a property that carries one.
---
--- THE PROPERTY NAMES ARE HALF OF IT. `BackgroundColor3 = props.Fill` decides a
--- fill without constructing anything, and a caller handed that prop has
--- already lost the choice -- so `%u[%w_]*Color3?` and `%u[%w_]*Font` are read
--- as appearance wherever they appear. Lowercase spellings are somebody's local
--- (`byFont`, `fontKey`) and say nothing about what a thing looks like.
---
--- NOT TRANSPARENCY, NOT `Image`. A machine returning `BackgroundTransparency =
--- 1` is saying "a press has no appearance of its own", which is the opposite of
--- choosing one, and a cursor token is an identifier a host resolves. A name is
--- added here when something tries to decide a look through it, not in advance.
local function decidesAppearance(codeOnly: string): string?
	for _, name in ipairs(APPEARANCE_VALUES) do
		if string.find(codeOnly, `%f[%w_]{name}%f[^%w_]`) then
			return `names \`{name}\``
		end
	end
	for word in string.gmatch(codeOnly, "%f[%w_]%u[%w_]*") do
		if string.match(word, "Color3?$") or string.match(word, "Font$") then
			return `names \`{word}\``
		end
	end
	return nil
end

local result = process.exec("git", { "ls-files", "*.luau" })
if not result.ok then
	error("cannot list tracked files -- is this a git repository?", 0)
end

local failures: { string } = {}
local qualify: { string } = {}
local scanned = 0

for path in string.gmatch(result.stdout, "[^\r\n]+") do
	if not fs.isFile(path) or isVendored(path) then
		continue
	end
	if string.sub(path, 1, #SUBJECT) ~= SUBJECT then
		continue
	end

	scanned += 1
	local withStrings = stripComments(fs.readFile(path))
	local codeOnly = stripStrings(withStrings)

	local why = reachesTheFramework(withStrings)
		or namesAnEngineType(codeOnly)
		or (if inBoundary(path) then reachesOutsideTheBoundary(withStrings, path) else nil)

	--- BOTH RULES ARE REPORTED, not the first one that trips. A module that
	--- reaches vide AND picks a colour has two things wrong with it, and hearing
	--- about one, fixing it and hearing about the other is how a gate teaches
	--- that it is a list of hoops rather than a boundary.
	if inBoundary(path) then
		if why then
			table.insert(failures, `{path}: {why} -- Layer 1 reaches no framework`)
		end
		local looks = decidesAppearance(codeOnly)
		if looks then
			table.insert(failures, `{path}: {looks} -- Layer 1 decides nothing about appearance`)
		end
	end
	if not why then
		table.insert(qualify, path)
	end
end

table.sort(qualify)

print("")
print(`LAYER 1: {#qualify} of {scanned} modules under {SUBJECT} reach no framework and name no engine type`)
for _, path in ipairs(qualify) do
	local mark = if inBoundary(path) then "in " else "out"
	print(`  [{mark}] {path}`)
end

if #failures > 0 then
	print("")
	for _, f in ipairs(failures) do
		print(`  {f}`)
	end
	print(`VERIFY CORE HAS NO FRAMEWORK: FAILED ({#failures} problem(s))`)
	process.exit(1)
else
	print("")
	print(
		`VERIFY CORE HAS NO FRAMEWORK: PASS (boundary reaches no framework and decides no appearance; `
			.. `{#qualify} module(s) qualify, marked in/out above)`
	)
end
